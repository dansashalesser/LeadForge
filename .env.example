# LeadForge credential example. GENERATED FILE: do not edit by hand.
# Regenerate with: uv run python -m leadforge.lead_ingestion.env_example
# Copy to .env and fill in values. Never commit real values.

# SQLAlchemy URL; leave empty for the local default database file
# database docs: https://docs.sqlalchemy.org/en/20/core/engines.html#database-urls
DATABASE_URL=

# chat model provider passed to LangChain init_chat_model; empty means the llm.provider of config/outreach.yaml
# llm docs: https://python.langchain.com/docs/how_to/chat_models_universal_init/
LEADFORGE_LLM_PROVIDER=

# chat model name passed to LangChain init_chat_model; empty means the llm.model of config/outreach.yaml
# llm docs: https://python.langchain.com/docs/how_to/chat_models_universal_init/
LEADFORGE_LLM_MODEL=

# key for the default anthropic provider (another provider reads <PROVIDER>_API_KEY); unset means offline templates and no live users search
# llm docs: https://docs.anthropic.com/en/api/getting-started
ANTHROPIC_API_KEY=

# secret key for the HMAC-SHA256 Match Key digests in merge logs; at least 32 bytes of UTF-8 text (e.g. the output of openssl rand -hex 32); keep it stable to compare digests across runs; unset means a random per-run key and digests that match no other run
# merge log docs: https://docs.python.org/3/library/hmac.html
LEADFORGE_MATCH_KEY_SECRET=

# apollo docs: https://docs.apollo.io/reference/people-api-search
APOLLO_API_KEY=

# optional: your Apollo plan, one of free, basic, professional, organization; sizes the rate limits (https://docs.apollo.io/reference/rate-limits); unset means free
# apollo docs: https://docs.apollo.io/reference/people-api-search
APOLLO_PLAN=

# private app access token with scopes crm.objects.contacts.read and crm.objects.deals.read
# hubspot docs: https://developers.hubspot.com/docs/api-reference/latest/crm/search-the-crm
HUBSPOT_ACCESS_TOKEN=

# hubspot docs: https://developers.hubspot.com/docs/api-reference/latest/crm/search-the-crm
HUBSPOT_API_VERSION=

# hunter docs: https://hunter.io/api-documentation/v2
HUNTER_API_KEY=

# optional: your Hunter plan, one of data, all-in-one, free; prices an Email Verifier call (data 1 credit, all-in-one and free 0.5; https://help.hunter.io/en/articles/1911617-how-do-credits-work-in-hunter) and caps a free plan's domain search at 10 addresses; unset means data
# hunter docs: https://hunter.io/api-documentation/v2
HUNTER_PLAN=

# google_search docs: https://serpapi.com/search-api
SERPAPI_API_KEY=

# optional: searches per hour on your SerpApi plan (Free 50, Starter 200, Developer 1000, Production 3000, Big Data 6000; https://serpapi.com/pricing); unset means 50
# google_search docs: https://serpapi.com/search-api
SERPAPI_HOURLY_LIMIT=
